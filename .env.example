# Copia este archivo a .env y reemplaza los valores antes de iniciar Docker
APP_PORT=8080

POSTGRES_DB=latinex_wtp
POSTGRES_USER=wtp_admin
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_POSTGRES_SEGURO

# Contraseña para ingresar a /admin
ADMIN_PASSWORD=CAMBIAR_PASSWORD_ADMIN_SEGURO

# Clave aleatoria de al menos 32 caracteres para firmar la cookie HttpOnly
SESSION_SECRET=CAMBIAR_POR_HEX_ALEATORIO_DE_64_CARACTERES

# false en local (http://localhost), true en AWS detrás de HTTPS
COOKIE_SECURE=false
